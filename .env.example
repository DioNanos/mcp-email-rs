# mcp-email-rs Configuration
# Copy to .env and fill in your values

# --- IMAP (required) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_TLS=true
IMAP_TLS_REJECT_UNAUTHORIZED=true
# false DISABLES TLS certificate verification: every connection then
# logs a prominent WARNING on stderr (MITM risk). Keep true unless you
# know you need it.

# Auth mechanism: plain (default), login, xoauth2, cram-md5, auto
IMAP_AUTH=plain

# Only needed if IMAP_AUTH=xoauth2
# IMAP_XOAUTH2_TOKEN=

# --- SMTP (optional — defaults to IMAP values) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_STARTTLS=false

# --- Connection Pool ---
# EMAIL_POOL_MAX_CONNECTIONS=4
# EMAIL_POOL_IDLE_TIMEOUT=300
# Per-operation IMAP timeout in seconds; values are clamped to 1..=300.
# EMAIL_OPERATION_TIMEOUT=30

# --- Config File (optional) ---
# EMAIL_CONFIG=/path/to/email.toml

# --- Outgoing attachments (send_email / create_draft / update_draft) ---
# Dedicated STAGING directory the server reads attachment files from.
# Must be a dedicated, admin-managed, TRUSTED directory, separate from
# EMAIL_DOWNLOAD_DIR, populated only with files that caller is allowed
# to send. Left unset: attachments are DISABLED entirely (no fallback
# to cwd or home — by design).
# EMAIL_ATTACH_DIR=/var/spool/mcp-email/attach-staging
# Cap on the SERIALIZED MIME size of the whole message (headers and
# transfer encoding included — base64 inflates raw bytes by ~4/3).
# EMAIL_ATTACH_MAX_MIME_BYTES=25000000
# Max number of attachments per message.
# EMAIL_ATTACH_MAX_COUNT=50
# SECURITY LIMITS (read before pointing this at anything sensitive):
# - any file already inside the staging directory is readable by whoever
#   can drive this server and guess/learn the relative path;
# - the no-symlink rule does NOT stop hardlinks, bind mounts, or another
#   process writing to the same inode;
# - the staging root is re-opened for every file (not pinned at startup):
#   whoever can replace the root directory itself is not stopped by this
#   code. The path resolution only confines requests BENEATH whatever the
#   root is at that moment.
